import java.util.*;
import java.util.function.ToIntFunction;

public class Experiment11 {

    static void d(String m, ArrayList<?> a) {
        System.out.println(m);
        System.out.println("  Content: " + a);
        System.out.println("  Size: " + a.size());
        System.out.println();
    }

    public static void main(String[] args) {
        System.out.println(" ArrayList INSERTION & DELETION    ");
        ArrayList<String> f = new ArrayList<>();

        System.out.println("========== INSERTION OPERATIONS ==========\n");

        System.out.println("1. add(element) - Adding elements at end:");
        f.addAll(Arrays.asList("Apple","Banana","Cherry"));
        d("   After adding Apple, Banana, Cherry:",f);

        System.out.println("2. add(index, element) - Insert at specific position:");
        f.add(1,"Mango");
        d("   After adding Mango at index 1:",f);
        f.add(0,"Grapes");
        d("   After adding Grapes at index 0:",f);

        System.out.println("3. addAll(collection) - Adding multiple elements:");
        f.addAll(Arrays.asList("Orange","Kiwi","Papaya"));
        d("   After addAll([Orange, Kiwi, Papaya]):",f);

        System.out.println("4. addAll(index, collection) - Insert collection at position:");
        f.addAll(3,Arrays.asList("Strawberry","Blueberry"));
        d("   After addAll(3, [Strawberry, Blueberry]):",f);

        System.out.println("5. set(index, element) - Replace element:");
        String old=f.set(0,"Green Grapes");
        System.out.println("   Replaced '"+old+"' with 'Green Grapes' at index 0");
        d("   After replacement:",f);

        System.out.println("========== DELETION OPERATIONS ==========\n");
        System.out.println("Current ArrayList:");
        d("",f);

        System.out.println("6. remove(index) - Remove by index:");
        String r=f.remove(0);
        System.out.println("   Removed element at index 0: "+r);
        d("   After removal:",f);

        System.out.println("7. remove(object) - Remove by object:");
        boolean b=f.remove("Kiwi");
        System.out.println("   Removed 'Kiwi': "+b);
        d("   After removal:",f);
        b=f.remove("Watermelon");
        System.out.println("   Removed 'Watermelon' (not in list): "+b);

        System.out.println("\n8. removeAll(collection) - Remove multiple elements:");
        ArrayList<String> x=new ArrayList<>(Arrays.asList("Strawberry","Blueberry"));
        f.removeAll(x);
        System.out.println("   Removed all berries: "+x);
        d("   After removeAll:",f);

        System.out.println("9. removeIf(predicate) - Conditional removal:");
        f.addAll(Arrays.asList("Apricot","Avocado","Plum"));
        System.out.println("   Added: Apricot, Avocado, Plum");
        d("   Current list:",f);
        f.removeIf(s->s.startsWith("A"));
        System.out.println("   Removed all fruits starting with 'A'");
        d("   After removeIf:",f);

        System.out.println("10. Remove using Iterator:");
        f.addAll(Arrays.asList("Peach","Pear","Plum"));
        d("   Added Peach, Pear, Plum:",f);

        Iterator<String> i=f.iterator();
        while(i.hasNext()) {
            String s=i.next();
            if(s.startsWith("P")) {
                i.remove();
                System.out.println("   Removed: "+s);
            }
        }
        d("   After removing fruits starting with 'P':",f);

        System.out.println("11. retainAll(collection) - Keep only specified elements:");
        f.addAll(Arrays.asList("Apple","Banana","Cherry","Date","Elderberry"));
        d("   Added more fruits:",f);
        ArrayList<String> keep=new ArrayList<>(Arrays.asList("Apple","Banana","Cherry"));
        f.retainAll(keep);
        System.out.println("   Retained only: "+keep);
        d("   After retainAll:",f);

        System.out.println("12. clear() - Remove all elements:");
        f.clear();
        d("   After clear():",f);
        System.out.println("   isEmpty(): "+f.isEmpty());

        System.out.println("\n========== OTHER ArrayList OPERATIONS ==========\n");

        f=new ArrayList<>(Arrays.asList(
                "Apple","Banana","Cherry","Date","Apple","Elderberry","Apple"));
        d("Reinitialized ArrayList:",f);

        System.out.println("13. Search Operations:");
        System.out.println("   contains('Banana'): "+f.contains("Banana"));
        System.out.println("   contains('Mango'): "+f.contains("Mango"));
        System.out.println("   indexOf('Apple'): "+f.indexOf("Apple"));
        System.out.println("   lastIndexOf('Apple'): "+f.lastIndexOf("Apple"));
        System.out.println("   get(2): "+f.get(2));

        System.out.println("\n14. toArray():");
        System.out.println("   Array: "+Arrays.toString(f.toArray()));
        System.out.println("   String Array: "+Arrays.toString(f.toArray(new String[0])));

        System.out.println("\n15. subList(fromIndex, toIndex):");
        System.out.println("   subList(1, 4): "+f.subList(1,4));

        System.out.println("\n16. Sorting:");
        Collections.sort(f);
        d("   After Collections.sort():",f);
        Collections.sort(f,Collections.reverseOrder());
        d("   After reverse sort:",f);

        System.out.println("17. Iteration Methods:");
        System.out.println("   Using for-each loop:");
        System.out.print("   ");
        for(String s:f) System.out.print(s+" ");
        System.out.println();

        System.out.println("\n   Using forEach with lambda:");
        System.out.print("   ");
        f.forEach(s->System.out.print(s+" | "));
        System.out.println();

        System.out.println("\n   Using ListIterator (bidirectional):");
        ListIterator<String> li=f.listIterator();
        System.out.print("   Forward: ");
        while(li.hasNext()) System.out.print(li.next()+" ");
        System.out.print("\n   Backward: ");
        while(li.hasPrevious()) System.out.print(li.previous()+" ");
        System.out.println();

        System.out.println("\n========== ArrayList with Integers ==========\n");

        ArrayList<Integer> n=new ArrayList<>(Arrays.asList(5,2,8,1,9,3,7));
        d("Integer ArrayList:",n);

        n.add(10);
        n.add(0,0);
        d("After adding 10 at end and 0 at beginning:",n);

        n.remove(Integer.valueOf(5));
        System.out.println("Removed Integer 5");
        n.remove(0);
        System.out.println("Removed element at index 0");
        d("After removals:",n);

        Collections.sort(n);
        d("After sorting:",n);

        System.out.println("Sum of elements: "+n.stream().mapToInt(new ToIntFunction<Integer>() {

            public int applyAsInt(Integer x) {
                return x;
            }
        }).sum());
        System.out.println("Max element: "+Collections.max(n));
        System.out.println("Min element: "+Collections.min(n));

        System.out.println("\n===== PROGRAM COMPLETED =====");
    }
}
